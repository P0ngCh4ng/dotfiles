{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/scripts/check-project-docs.js\""
          }
        ],
        "description": "Check for project architecture and database documentation"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/scripts/enforce-session-start.js\""
          }
        ],
        "description": "⚠️ CRITICAL: Load project context from projects.yml (enforces 00-session-start.md)"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/scripts/track-doc-updates.js\""
          }
        ],
        "description": "Track file modifications and suggest documentation updates"
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "TOOL_NAME=\"{{tool_name}}\" node \"$HOME/.claude/hooks/scripts/enforce-agent-launch.js\""
          }
        ],
        "description": "⚠️ REMINDER: Auto-launch code-reviewer after code changes (enforces agent-automation.md)"
      }
    ]
  }
}
