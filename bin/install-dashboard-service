#!/usr/bin/env zsh
# Install/reload the pj-dashboard launchd agent so the dashboard server
# starts automatically at login and keeps running in the background,
# instead of needing `pj-dashboard` to start it manually each session.
# Usage: install-dashboard-service

set -euo pipefail

SCRIPT_DIR="${0:A:h}"
DOTFILES_DIR="${SCRIPT_DIR:h}"
DASHBOARD_SCRIPT="${DOTFILES_DIR}/bin/generate-project-dashboard"
LABEL="com.pongchang.pj-dashboard"
PLIST_PATH="${HOME}/Library/LaunchAgents/${LABEL}.plist"
LOG_DIR="${DOTFILES_DIR}/.dashboard"
PORT=9797

if [[ ! -x "$DASHBOARD_SCRIPT" ]]; then
  echo "❌ Error: $DASHBOARD_SCRIPT not found or not executable"
  exit 1
fi

PYTHON_BIN="$(command -v python3 || true)"
if [[ -z "$PYTHON_BIN" ]]; then
  echo "❌ Error: python3 not found in PATH"
  exit 1
fi

mkdir -p "$LOG_DIR" "${PLIST_PATH:h}"

cat > "$PLIST_PATH" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>${LABEL}</string>
  <key>ProgramArguments</key>
  <array>
    <string>${PYTHON_BIN}</string>
    <string>${DASHBOARD_SCRIPT}</string>
    <string>--serve</string>
    <string>--port</string>
    <string>${PORT}</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>${LOG_DIR}/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>${LOG_DIR}/launchd.log</string>
</dict>
</plist>
EOF

echo "✅ Wrote $PLIST_PATH"

launchctl unload "$PLIST_PATH" 2>/dev/null || true
launchctl load -w "$PLIST_PATH"

sleep 1
if curl -s -o /dev/null -m 2 "http://localhost:${PORT}/api/status"; then
  echo "✅ Dashboard is running at http://localhost:${PORT}/ (auto-starts at login from now on)"
else
  echo "⚠️  Service loaded but not responding yet -- check ${LOG_DIR}/launchd.log"
fi

echo ""
echo "To disable autostart later:"
echo "  launchctl unload $PLIST_PATH && rm $PLIST_PATH"
