#!/usr/bin/env python3
"""Generate and serve a local dashboard listing all projects from projects.yml.

Unlike a browser-side fetch() probe (unreliable for non-HTTP ports and easy
to get wrong), liveness is checked the same way the existing `check-ports` /
`port-scan` zsh functions do: by asking the OS which TCP ports are actually
LISTENing via `lsof`. That check runs fresh on every poll, server-side.

Usage:
  generate-project-dashboard            # one-shot HTML snapshot, no live JS
  generate-project-dashboard --serve [--port N]
      # regenerate + serve on http://localhost:N/ with a same-origin
      # /api/status endpoint the page polls every few seconds

Output: ~/dotfiles/.dashboard/index.html
"""

import argparse
import json
import re
import subprocess
import sys
from datetime import datetime
from http.server import SimpleHTTPRequestHandler
from pathlib import Path
from socketserver import TCPServer

try:
    import yaml
except ImportError:
    sys.exit("Error: PyYAML is required. Install with: pip3 install pyyaml")

DOTFILES_DIR = Path(__file__).resolve().parent.parent
PROJECTS_FILE = DOTFILES_DIR / "projects.yml"
OUTPUT_DIR = DOTFILES_DIR / ".dashboard"
OUTPUT_FILE = OUTPUT_DIR / "index.html"
DEFAULT_PORT = 9797
HOME_DIR = str(Path.home())

# Ports considered databases/infra rather than app servers, purely for the
# 🗄 icon vs 🌐 link styling. Liveness is checked for every port the same way.
KNOWN_DB_PORTS = {3306, 5432, 6379, 27017, 5433, 1433, 11211, 9200, 5984}

PROJECT_NAME_RE = re.compile(r"^[a-z0-9][a-z0-9_-]*$")


def yaml_quote(value):
    """Wrap a free-text string as a safe double-quoted YAML scalar so
    user-supplied text (from the registration form) can never break the
    surrounding YAML structure or inject additional keys."""
    escaped = str(value).replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n")
    return f'"{escaped}"'


def load_projects():
    if not PROJECTS_FILE.exists():
        sys.exit(f"Error: projects.yml not found at {PROJECTS_FILE}")
    data = yaml.safe_load(PROJECTS_FILE.read_text()) or {}
    return data.get("projects", {}) or {}


def classify_ports(project):
    db_ports = set(KNOWN_DB_PORTS)
    for db in project.get("databases", []) or []:
        port = db.get("port")
        if port:
            db_ports.add(int(port))

    ports = project.get("ports", []) or []
    web_ports = sorted(p for p in ports if int(p) not in db_ports)
    data_ports = sorted(p for p in ports if int(p) in db_ports)
    return web_ports, data_ports


def build_entries(projects):
    entries = []
    for name, project in sorted(projects.items()):
        project = project or {}
        web_ports, data_ports = classify_ports(project)
        entries.append(
            {
                "name": name,
                "path": project.get("path", ""),
                "description": project.get("description", ""),
                "tech": project.get("tech", []) or [],
                "web_ports": web_ports,
                "data_ports": data_ports,
                "db_types": {
                    int(db["port"]): db.get("type", "db")
                    for db in (project.get("databases", []) or [])
                    if db.get("port")
                },
                # `always_on: true` marks a project the dashboard should treat
                # as "must be running" -- it's badged, and warns (banner + red
                # card) whenever none of its ports are listening. `can_start`
                # says whether a one-click launch is possible (a start_command
                # is configured); the command itself is never sent to the
                # browser -- /api/start looks it up server-side by name.
                "always_on": bool(project.get("always_on", False)),
                "can_start": bool(str(project.get("start_command", "")).strip()),
                # Sent to the browser only to prefill the ⚙ config form's
                # edit field -- execution still goes through /api/start, which
                # reads the command from projects.yml by name, never from the
                # request. Safe: the dashboard binds 127.0.0.1 (single user).
                "start_command": str(project.get("start_command", "") or ""),
            }
        )
    return entries


def fetch_process_details(pids):
    """Batched lookup of full command line + working directory for a set of
    pids (one `ps` call + one `lsof` call total, not one per process). A
    truncated lsof COMMAND like "ControlCe" or "Adobe\\x20" isn't enough to
    tell whether an unregistered port belongs to a real project worth
    registering -- the full command line and cwd usually are."""
    pids = sorted({str(p) for p in pids if p})
    details = {p: {"cmdline": "", "cwd": ""} for p in pids}
    if not pids:
        return details

    try:
        out = subprocess.run(
            ["ps", "-ww", "-p", ",".join(pids), "-o", "pid=,command="],
            capture_output=True,
            text=True,
            timeout=3,
        ).stdout
        for line in out.splitlines():
            line = line.strip()
            if not line:
                continue
            pid_str, _, cmd = line.partition(" ")
            if pid_str in details:
                details[pid_str]["cmdline"] = cmd.strip()
    except Exception:
        pass

    try:
        out = subprocess.run(
            ["lsof", "-a", "-p", ",".join(pids), "-d", "cwd", "-Fpn"],
            capture_output=True,
            text=True,
            timeout=3,
        ).stdout
        current_pid = None
        for line in out.splitlines():
            if not line:
                continue
            tag, value = line[0], line[1:]
            if tag == "p":
                current_pid = value
            elif tag == "n" and current_pid in details:
                details[current_pid]["cwd"] = value
    except Exception:
        pass

    return details


def scan_listening():
    """Same technique as the existing check-ports/port-scan zsh functions:
    ask lsof which TCP ports are actually LISTENing right now. Also enriches
    each entry with the owning process's full command line and cwd, so
    unregistered ports (not in projects.yml) can be identified well enough
    to decide whether to register them -- a bare port number can't do that."""
    try:
        out = subprocess.run(
            ["lsof", "-iTCP", "-sTCP:LISTEN", "-n", "-P"],
            capture_output=True,
            text=True,
            timeout=5,
        ).stdout
    except Exception:
        return {}

    # NAME column looks like "*:3000" or "127.0.0.1:3000" or "[::1]:3000",
    # but lsof also appends a trailing "(LISTEN)" state field after it, so
    # the port field is NOT necessarily the last token on the line -- find
    # the address:port token explicitly instead of trusting a fixed index.
    by_port = {}
    for line in out.splitlines()[1:]:
        fields = line.split()
        if len(fields) < 2:
            continue
        command, pid = fields[0], fields[1]
        for field in fields:
            m = re.search(r":(\d+)$", field)
            if m:
                port = int(m.group(1))
                by_port.setdefault(port, {"port": port, "command": command, "pid": pid})
                break

    details = fetch_process_details(item["pid"] for item in by_port.values())
    for item in by_port.values():
        d = details.get(item["pid"], {"cmdline": "", "cwd": ""})
        item["cmdline"] = d["cmdline"]
        item["cwd"] = d["cwd"]
    return by_port


def register_project(payload):
    """Append a new project to projects.yml from the dashboard's inline
    registration form. Returns (ok, error_message_or_None)."""
    name = str(payload.get("name", "")).strip().lower()
    path = str(payload.get("path", "")).strip()
    description = str(payload.get("description", "")).strip()
    tech = [t.strip() for t in str(payload.get("tech", "")).split(",") if t.strip()]

    try:
        ports = sorted({int(p) for p in (payload.get("ports") or [])})
    except (TypeError, ValueError):
        return False, "invalid ports"

    if not PROJECT_NAME_RE.match(name) or name == "projects":
        return False, "name must be lowercase letters/digits/-/_ (and not 'projects')"
    if not path:
        return False, "path is required"

    try:
        existing = load_projects()
    except Exception as e:
        return False, f"could not read projects.yml: {e}"
    if name in existing:
        return False, f'"{name}" is already registered'

    lines = [
        f"  {name}:",
        f"    path: {yaml_quote(path)}",
        f"    ports: [{', '.join(str(p) for p in ports)}]",
    ]
    if description:
        lines.append(f"    description: {yaml_quote(description)}")
    if tech:
        lines.append(f"    tech: [{', '.join(yaml_quote(t) for t in tech)}]")
    block = "\n" + "\n".join(lines) + "\n"

    with PROJECTS_FILE.open("a", encoding="utf-8") as f:
        f.write(block)

    try:
        load_projects()
    except Exception as e:
        return False, f"written but projects.yml no longer parses ({e}) -- please fix it by hand"

    return True, None


def add_ports_to_project(name, new_ports):
    """Add port(s) to an *already-registered* project's `ports:` line.

    Used when a discovered process's cwd is inside a project that's already
    in projects.yml (e.g. a second dev-server port for `onlinemedic`) -- in
    that case the right move is extending the existing entry, not creating a
    same-named duplicate. Done as a targeted single-line text edit (find the
    project's block, find its `ports:` line, rewrite just that line) rather
    than a full YAML re-dump, so every comment/blank line/formatting choice
    elsewhere in the hand-maintained file is left completely untouched.
    """
    try:
        existing = load_projects()
    except Exception as e:
        return False, f"could not read projects.yml: {e}"
    if name not in existing:
        return False, f'"{name}" is not a registered project'

    block_start_re = re.compile(r"^  " + re.escape(name) + r":\s*\n?$")
    other_key_re = re.compile(r"^  [A-Za-z0-9_-]+:\s*\n?$")
    # Captures an optional trailing "# comment" (e.g. "ports: [8888]  #
    # webpack devServer") so it's preserved verbatim on rewrite instead of
    # being silently dropped.
    ports_line_re = re.compile(r"^(\s+)ports:\s*\[([^\]]*)\](\s*#.*)?\s*\n?$")

    lines = PROJECTS_FILE.read_text().splitlines(keepends=True)
    in_block = False
    for i, line in enumerate(lines):
        if not in_block:
            if block_start_re.match(line):
                in_block = True
            continue
        if other_key_re.match(line):
            break
        m = ports_line_re.match(line)
        if m:
            indent, existing_ports, comment = m.groups()
            ports = {int(p.strip()) for p in existing_ports.split(",") if p.strip()}
            ports.update(int(p) for p in new_ports)
            lines[i] = f"{indent}ports: [{', '.join(str(p) for p in sorted(ports))}]{comment or ''}\n"
            PROJECTS_FILE.write_text("".join(lines))
            try:
                load_projects()
            except Exception as e:
                return False, f"written but projects.yml no longer parses ({e}) -- please fix it by hand"
            return True, None

    return False, f'"{name}" has no `ports:` line to update'


def _project_block_bounds(lines, name):
    """Return (start, end) line indices of a project's YAML block: `start`
    is the `  name:` line, `end` is the next top-level (2-space) project key
    or len(lines). Returns (None, None) if the project isn't found."""
    block_start_re = re.compile(r"^  " + re.escape(name) + r":\s*\n?$")
    other_key_re = re.compile(r"^  [A-Za-z0-9_-]+:\s*\n?$")
    start = None
    for i, line in enumerate(lines):
        if start is None:
            if block_start_re.match(line):
                start = i
            continue
        if other_key_re.match(line):
            return start, i
    return (start, len(lines)) if start is not None else (None, None)


def _find_project_key_line(lines, start, end, indent, key):
    """Index of a project-level `key:` line within (start, end), or None.
    Matches only lines at exactly `indent` so a same-named nested key (e.g.
    a database's `name:`) is never touched."""
    key_re = re.compile(r"^(\s*)" + re.escape(key) + r":\s")
    for i in range(start + 1, end):
        m = key_re.match(lines[i])
        if m and m.group(1) == indent:
            return i
    return None


def set_project_config(name, always_on, start_command):
    """Edit an already-registered project's `always_on` / `start_command`
    from the dashboard's ⚙ config form.

    always_on: True inserts/keeps `always_on: true`; False removes the line.
    start_command: None leaves it untouched; "" removes the line; any other
    string sets it (double-quoted). Done as targeted single-line inserts/
    rewrites/deletes so the rest of the hand-maintained file -- comments,
    blank lines, database blocks -- is left byte-for-byte intact. The whole
    file is rolled back if the edit somehow produces invalid YAML."""
    try:
        existing = load_projects()
    except Exception as e:
        return False, f"could not read projects.yml: {e}"
    if name not in existing:
        return False, f'"{name}" is not a registered project'

    original = PROJECTS_FILE.read_text()
    lines = original.splitlines(keepends=True)
    start, end = _project_block_bounds(lines, name)
    if start is None:
        return False, f'could not locate "{name}" block in projects.yml'

    # Project-level indent = indent of the block's first child line.
    indent = "    "
    for line in lines[start + 1:end]:
        m = re.match(r"^(\s+)\S", line)
        if m and len(m.group(1)) > 2:
            indent = m.group(1)
            break

    def anchor():
        # Insert new keys right after `ports:` (or `path:`) to match the
        # existing hand-written ordering; fall back to just after the header.
        for key in ("ports", "path"):
            idx = _find_project_key_line(lines, *_project_block_bounds(lines, name), indent, key)
            if idx is not None:
                return idx + 1
        return _project_block_bounds(lines, name)[0] + 1

    def upsert(key, value):
        s, e = _project_block_bounds(lines, name)
        idx = _find_project_key_line(lines, s, e, indent, key)
        new_line = f"{indent}{key}: {value}\n"
        if idx is not None:
            lines[idx] = new_line
        else:
            lines.insert(anchor(), new_line)

    def remove(key):
        s, e = _project_block_bounds(lines, name)
        idx = _find_project_key_line(lines, s, e, indent, key)
        if idx is not None:
            del lines[idx]

    if always_on:
        upsert("always_on", "true")
    else:
        remove("always_on")

    if start_command is not None:
        cmd = str(start_command).strip()
        if cmd:
            upsert("start_command", yaml_quote(cmd))
        else:
            remove("start_command")

    PROJECTS_FILE.write_text("".join(lines))
    try:
        load_projects()
    except Exception as e:
        PROJECTS_FILE.write_text(original)  # roll back the whole file
        return False, f"edit produced invalid YAML ({e}); rolled back, file unchanged"

    return True, None


def start_project(name):
    """Launch a project's configured `start_command` from the dashboard's
    "▶ 起動" button. Only the project *name* crosses from the browser; the
    command itself is read from projects.yml here (never accepted from the
    request body), so the page can't be tricked into running arbitrary shell.

    The command is run detached (own session, no stdio) in the project's
    directory so it keeps running independently of this HTTP request and of
    the dashboard server. Note: the child inherits *this server's*
    environment -- rich when started via `pj-dashboard` in a shell, minimal
    under launchd -- so a start_command that needs PATH entries (node, uv,
    docker...) should use absolute paths or `source` a profile itself.
    """
    try:
        projects = load_projects()
    except Exception as e:
        return False, f"could not read projects.yml: {e}"

    project = projects.get(name)
    if not project:
        return False, f'"{name}" is not a registered project'

    command = str(project.get("start_command", "")).strip()
    if not command:
        return False, f'"{name}" has no start_command in projects.yml'

    cwd = Path(str(project.get("path", "")).strip()).expanduser()
    if not cwd.is_dir():
        return False, f"path does not exist: {cwd}"

    try:
        subprocess.Popen(
            command,
            shell=True,
            cwd=str(cwd),
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except Exception as e:
        return False, str(e)

    return True, None


