    color: var(--text);
  }
  a.port-badge:hover { outline: 1px solid var(--accent); }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--checking);
    flex-shrink: 0;
  }
  .dot.up { background: var(--up); }
  .dot.down { background: var(--down); }
  .db-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--badge-bg);
    border-radius: 8px;
    padding: 4px 10px;
    font-size: 12px;
    color: var(--text-dim);
  }
  .none { color: var(--text-dim); font-size: 12px; }
  .refresh-btn {
    border: 1px solid var(--border);
    background: var(--card-bg);
    color: var(--text);
    border-radius: 8px;
    padding: 4px 12px;
    font-size: 13px;
    cursor: pointer;
  }
  .refresh-btn:hover { border-color: var(--accent); }
  .ignored-link {
    color: #fff;
    opacity: 0.85;
    cursor: pointer;
    text-decoration: underline;
    font-size: 12px;
    background: none;
    border: none;
    font-weight: 400;
  }
</style>
</head>
<body>
<header>
  <div>
    <h1>Local Project Dashboard</h1>
    <div class="meta">projects.yml から生成 &middot; 生成日時: __GENERATED_AT__</div>
  </div>
  <div style="display:flex; align-items:center; gap:12px;">
    <div class="summary" id="summary">checking&hellip;</div>
    <button class="refresh-btn" id="refresh-btn">Recheck now</button>
  </div>
</header>
<div id="alwayson-banner"></div>
<div id="unregistered-banner">
  <span id="unregistered-banner-text"></span>
  <button class="ignored-link" id="ignored-link" style="display:none;"></button>
</div>
<div id="offline-banner">⚠️ ライブ状態を取得できません。ターミナルで <code>pj-dashboard</code> を実行してサーバーモードで開いてください（このページを直接ファイルとして開いた場合は実測できません）。</div>

<div class="grid" id="grid"></div>

<script>
const PROJECTS = __PROJECTS_JSON__;
const DASH_PORT = __DASH_PORT__;
const HOME_DIR = __HOME_DIR__;

// projects.yml conventionally writes paths as "~/foo"; lsof's cwd always
// comes back as the absolute "/Users/xxx/foo". Without normalizing these to
// one form, the same directory looks like two unrelated things depending on
// whether it came from a registered project or a live process.
function shortenPath(p) {
  if (!p) return p;
  if (p === HOME_DIR) return '~';
  if (p.startsWith(HOME_DIR + '/')) return '~' + p.slice(HOME_DIR.length);
  return p;
}

const grid = document.getElementById('grid');

// All ports that projects.yml already accounts for (web + db), so the
// "unregistered" section below only shows genuinely unknown listeners.
const KNOWN_PORTS = new Set();
for (const p of PROJECTS) {
  for (const port of p.web_ports) KNOWN_PORTS.add(port);
  for (const port of p.data_ports) KNOWN_PORTS.add(port);
}

// Identities (a cwd path, or a command name when cwd is unknown) the user
// has confirmed are not a project (Unity, Adobe helpers, rapportd, etc.) so
// they stop drowning out an actually-forgotten project registration.
// Dismissed by cwd/command rather than port (many ports are ephemeral /
// re-assigned on every launch).
const IGNORE_KEY = 'pj-dashboard-ignored-commands';
function loadIgnored() {
  try {
    return new Set(JSON.parse(localStorage.getItem(IGNORE_KEY) || '[]'));
  } catch (e) {
    return new Set();
  }
}
function saveIgnored(set) {
  localStorage.setItem(IGNORE_KEY, JSON.stringify(Array.from(set)));
}
let ignoredIdentities = loadIgnored();

const banner = document.getElementById('unregistered-banner');
const bannerText = document.getElementById('unregistered-banner-text');
const ignoredLink = document.getElementById('ignored-link');

ignoredLink.addEventListener('click', () => {
  if (!confirm(`無視リスト (${ignoredIdentities.size}件) をリセットしますか？`)) return;
  ignoredIdentities = new Set();
  saveIgnored(ignoredIdentities);
  checkAll();
});

function el(tag, attrs, children) {
  const e = document.createElement(tag);
  for (const [k, v] of Object.entries(attrs || {})) {
    if (k === 'class') e.className = v;
    else if (k === 'text') e.textContent = v;
    else e.setAttribute(k, v);
  }
  for (const c of children || []) e.appendChild(c);
  return e;
}

// always_on cards, wired up in the build loop below and updated every poll
// by updateAlwaysOn() so a stopped "must be running" project shows red + a
// one-click "▶ 起動".
const alwaysOnCards = [];

async function startProject(name, button) {
  const original = button.textContent;
  button.disabled = true;
  button.textContent = '起動中…';
  try {
    const res = await fetch('/api/start', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name }),
    });
    const data = await res.json();
    if (!data.ok) throw new Error(data.error || 'failed');
    // Give the process a moment to bind its port, then recheck so the card
    // flips green on its own without the user having to hit "Recheck now".
    setTimeout(() => {
      button.disabled = false;
      button.textContent = original;
      checkAll();
    }, 2500);
  } catch (e) {
    alert('起動に失敗しました: ' + e.message);
    button.disabled = false;
    button.textContent = original;
  }
}

for (const p of PROJECTS) {
  const card = el('div', { class: 'card' });
  const h2 = el('h2', { text: p.name });
  if (p.always_on) {
    card.appendChild(el('div', { class: 'card-head' }, [h2, el('span', { class: 'always-badge', text: '🔁 常駐' })]));
  } else {
    card.appendChild(h2);
  }
  if (p.description) card.appendChild(el('p', { class: 'desc', text: p.description }));
  if (p.path) card.appendChild(el('div', { class: 'path', text: p.path }));

  if (p.tech && p.tech.length) {
    const tech = el('div', { class: 'tech' });
    for (const t of p.tech) tech.appendChild(el('span', { text: t }));
    card.appendChild(tech);
  }

  const ports = el('div', { class: 'ports' });

  for (const port of p.web_ports) {
    const dot = el('span', { class: 'dot checking', 'data-port': port });
    const badge = el('a', {
      class: 'port-badge',
      href: `http://localhost:${port}`,
      target: '_blank',
      rel: 'noopener',
    }, [dot, document.createTextNode(':' + port)]);
    ports.appendChild(badge);
  }

  for (const port of p.data_ports) {
    const dbType = (p.db_types && p.db_types[port]) || 'db';
    const dot = el('span', { class: 'dot checking', 'data-port': port });
    ports.appendChild(el('span', { class: 'db-badge' }, [dot, document.createTextNode(`🗄️ ${dbType}:${port}`)]));
  }

  if (!p.web_ports.length && !p.data_ports.length) {
    ports.appendChild(el('span', { class: 'none', text: 'no ports' }));
  }

  card.appendChild(ports);

  const actions = el('div', { class: 'card-actions' });
  const configSlot = el('div');

  // "▶ 起動" only exists when always_on + a start_command is configured;
  // updateAlwaysOn() toggles its visibility by liveness.
  let startBtn = null;
  if (p.always_on && p.can_start) {
    startBtn = el('button', { class: 'dismiss-card primary', text: '▶ 起動', style: 'display:none;' });
    startBtn.addEventListener('click', () => startProject(p.name, startBtn));
    actions.appendChild(startBtn);
  }

  // ⚙ 設定 -- edit always_on / start_command right here (writes projects.yml).
  const configBtn = el('button', { class: 'dismiss-card', text: '⚙ 設定' });
  configBtn.addEventListener('click', () => {
    if (configSlot.childElementCount) {
      configSlot.innerHTML = '';
      return;
    }
    configSlot.appendChild(buildConfigForm(p, configSlot));
  });
  actions.appendChild(configBtn);

  card.appendChild(actions);
  card.appendChild(configSlot);

  if (p.always_on) alwaysOnCards.push({ project: p, card, startBtn });

  grid.appendChild(card);
}

// Inline ⚙ config editor for one project card: a 常駐 (always_on) checkbox
// and a start_command field. Saving POSTs to /api/set-config, which does a
// targeted edit of projects.yml, then the page reloads to reflect it.
function buildConfigForm(p, slot) {
  const alwaysCb = el('input', { type: 'checkbox', style: 'width:auto; margin:0;' });
  if (p.always_on) alwaysCb.checked = true;
  const alwaysLabel = el('label', {
    class: 'config-check',
  }, [alwaysCb, document.createTextNode(' 🔁 常時起動 (always_on)')]);

  const cmdInput = el('input', {
    type: 'text',
    value: p.start_command || '',
    placeholder: "start_command 例: zsh -lc 'npm run dev'",
  });

  const errorEl = el('div', { class: 'error' });
  const saveBtn = el('button', { class: 'dismiss-card primary', text: '保存' });
  const cancelBtn = el('button', { class: 'dismiss-card', text: 'キャンセル' });

  saveBtn.addEventListener('click', async () => {
    saveBtn.disabled = true;
    errorEl.textContent = '';
    try {
      const res = await fetch('/api/set-config', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: p.name,
          always_on: alwaysCb.checked,
          start_command: cmdInput.value,
        }),
      });
      const data = await res.json();
      if (!data.ok) throw new Error(data.error || 'failed');
      location.reload();
    } catch (e) {
      errorEl.textContent = '保存失敗: ' + e.message;
      saveBtn.disabled = false;
    }
  });
  cancelBtn.addEventListener('click', () => {
    slot.innerHTML = '';
  });

  return el('div', { class: 'register-form' }, [
    alwaysLabel,
    cmdInput,
    errorEl,
    el('div', { class: 'card-actions' }, [saveBtn, cancelBtn]),
  ]);
}

// Called each poll: a "must be running" project counts as up if ANY of its
// declared ports is listening. Down ones go red + surface their "▶ 起動"
// button, and a single banner names them all. Projects flagged always_on but
// with no ports can't be liveness-checked, so they just keep the launch
// button available without ever being flagged down.
function updateAlwaysOn(listeningPorts) {
  const down = [];
  for (const item of alwaysOnCards) {
    const p = item.project;
    const ports = [...p.web_ports, ...p.data_ports];
    const hasPorts = ports.length > 0;
    const up = ports.some((port) => listeningPorts.has(port));

    if (hasPorts && up) {
      item.card.classList.remove('always-down');
      if (item.startBtn) item.startBtn.style.display = 'none';
    } else {
      if (hasPorts) {
        item.card.classList.add('always-down');
        down.push(p.name);
      }
      if (item.startBtn) item.startBtn.style.display = '';
    }
  }

  const alwaysBanner = document.getElementById('alwayson-banner');
  if (down.length) {
    alwaysBanner.style.display = 'block';
    alwaysBanner.textContent = `⛔ 常駐指定のプロジェクトが停止中: ${down.join(', ')}`;
  } else {
    alwaysBanner.style.display = 'none';
  }
}

// Cards for processes that are still listening are kept and reused across
// polls (only their process/ports rows are refreshed) instead of being torn
// down and rebuilt every 5s -- rebuilding used to silently blow away an open
// "➕ 登録" form (and anything typed into it) out from under the user mid-edit.
const extraCardsByKey = new Map(); // key -> { card, group, processEl, portsEl }
let lastListening = [];

function dirBaseName(cwd) {
  return cwd.split('/').filter(Boolean).pop() || cwd;
}

// Is this cwd the same directory as (or inside) an *already-registered*
// project's path? If so this isn't a "new project?" candidate at all -- it's
// almost certainly just another port of that same project (e.g. a second
// dev-server port for `onlinemedic`) and should be merged into it, not left
// sitting next to it looking like an unrelated duplicate.
function findMatchingProject(cwd) {
  if (!cwd) return null;
  const short = shortenPath(cwd);
  return PROJECTS.find((p) => p.path && (short === p.path || short.startsWith(p.path + '/'))) || null;
}

async function killPid(pid, button) {
  button.disabled = true;
  try {
    const res = await fetch('/api/kill', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ pid }),
    });
    const data = await res.json();
    if (!data.ok) throw new Error(data.error || 'failed');
    return true;
  } catch (e) {
    alert('停止に失敗しました: ' + e.message);
    button.disabled = false;
    return false;
  }
}

// Grouped by cwd when known -- several ports/pids sharing the same working
// directory (e.g. a dev server + its HMR/websocket child process) are one
// project candidate, not several unrelated ones. Falls back to grouping by
// pid alone when cwd couldn't be resolved, since an empty cwd tells us
// nothing about whether two such processes are actually related.
function buildExtraCard(key) {
  const card = el('div', { class: 'card extra-card' });
  const headEl = el('div', { class: 'card-head' }, [el('h2', {})]);
  const descEl = el('p', { class: 'desc', text: '⚠️ projects.yml に未登録' });
  const matchEl = el('p', { class: 'match-note', style: 'display:none;' });
  const pathEl = el('div', { class: 'path' });
  const processEl = el('div', { class: 'process-list' });
  const portsEl = el('div', { class: 'ports' });
  card.appendChild(headEl);
  card.appendChild(descEl);
  card.appendChild(matchEl);
  card.appendChild(pathEl);
  card.appendChild(processEl);
  card.appendChild(portsEl);

  const formSlot = el('div');
  const entry = { card, headEl, descEl, matchEl, pathEl, processEl, portsEl, formSlot, group: null, matchedProject: null };

  const addToExistingBtn = el('button', { class: 'dismiss-card primary', style: 'display:none;' });
  addToExistingBtn.addEventListener('click', async () => {
    const target = entry.matchedProject;
    if (!target) return;
    const ports = Array.from(entry.group.processes.values()).flatMap((p) => p.ports);
    if (!confirm(`ポート ${ports.join(', ')} を既存プロジェクト "${target.name}" に追加しますか？`)) return;
    addToExistingBtn.disabled = true;
    try {
      const res = await fetch('/api/add-port', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: target.name, ports }),
      });
      const data = await res.json();
      if (!data.ok) throw new Error(data.error || 'failed');
      location.reload();
    } catch (e) {
      alert('追加に失敗しました: ' + e.message);
      addToExistingBtn.disabled = false;
    }
  });

  const registerBtn = el('button', { class: 'dismiss-card', text: '➕ 新規として登録' });
  registerBtn.addEventListener('click', () => {
    if (formSlot.childElementCount) {
      formSlot.innerHTML = '';
      return;
    }
    formSlot.appendChild(buildRegisterForm(entry, formSlot));
  });

  const dismissBtn = el('button', { class: 'dismiss-card', text: '✕ 今後表示しない' });
  dismissBtn.addEventListener('click', () => {
    const identity = entry.group.cwd || Array.from(entry.group.processes.values())[0].command;
    dismissBtn.title = `"${identity}" を今後表示しない`;
    ignoredIdentities.add(identity);
    saveIgnored(ignoredIdentities);
    renderExtra(lastListening);
  });

  entry.addToExistingBtn = addToExistingBtn;
  card.appendChild(el('div', { class: 'card-actions' }, [addToExistingBtn, registerBtn, dismissBtn]));
  card.appendChild(formSlot);

  return entry;
}

function refreshExtraCard(entry, group) {
  entry.group = group;
  const processes = Array.from(group.processes.values());
  const title = group.cwd ? dirBaseName(group.cwd) : processes[0].command;

  entry.headEl.querySelector('h2').textContent = title;
  entry.pathEl.textContent = group.cwd ? shortenPath(group.cwd) : `pid ${processes[0].pid} (cwd不明)`;

  entry.matchedProject = findMatchingProject(group.cwd);
  if (entry.matchedProject) {
    entry.matchEl.style.display = '';
    entry.matchEl.textContent = `🔗 登録済みプロジェクト "${entry.matchedProject.name}" と同じディレクトリです`;
    entry.addToExistingBtn.style.display = '';
    entry.addToExistingBtn.textContent = `➕ ${entry.matchedProject.name} に追加`;
  } else {
    entry.matchEl.style.display = 'none';
    entry.addToExistingBtn.style.display = 'none';
  }

  entry.processEl.innerHTML = '';
  if (processes.length > 1 || !group.cwd) {
    for (const proc of processes) {
      const killBtn = el('button', { text: '✕', title: `${proc.command} (pid ${proc.pid}) を終了` });
      killBtn.addEventListener('click', async () => {
        if (!confirm(`"${proc.command}" (pid ${proc.pid}) にSIGTERMを送って終了しますか？`)) return;
        if (await killPid(proc.pid, killBtn)) {
          renderExtra(lastListening);
        }
      });
      entry.processEl.appendChild(
        el('span', { class: 'process-pill' }, [
          document.createTextNode(`${proc.command} (pid ${proc.pid})`),
          killBtn,
        ])
      );
    }
  }

  entry.portsEl.innerHTML = '';
  const allPorts = Array.from(new Set(processes.flatMap((p) => p.ports))).sort((a, b) => a - b);
  for (const port of allPorts) {
    entry.portsEl.appendChild(
      el('a', { class: 'port-badge', href: `http://localhost:${port}`, target: '_blank', rel: 'noopener' }, [
        el('span', { class: 'dot up' }),
        document.createTextNode(':' + port),
      ])
    );
  }

  // Single-process cards still get the full command line + a one-click stop
  // (multi-process cards show that per-pid in the process list above).
  const existingCmdline = entry.card.querySelector('.cmdline');
  if (existingCmdline) existingCmdline.remove();
  if (processes.length === 1 && processes[0].cmdline) {
    entry.pathEl.insertAdjacentElement(
      'afterend',
      el('div', { class: 'cmdline', text: processes[0].cmdline, title: processes[0].cmdline })
    );
  }
}

function renderExtra(listening) {
  lastListening = listening;

  const allUnknown = listening.filter((item) => item.port !== DASH_PORT && !KNOWN_PORTS.has(item.port));
  const visible = allUnknown.filter(
    (item) => !ignoredIdentities.has(item.command) && !(item.cwd && ignoredIdentities.has(item.cwd))
  );
  const hiddenCount = allUnknown.length - visible.length;

  // Group by cwd when known (co-located processes are one project
  // candidate); fall back to pid alone when cwd is unresolved.
  const groups = new Map();
  for (const item of visible) {
    const key = item.cwd ? `cwd::${item.cwd}` : `pid::${item.command}::${item.pid}`;
    if (!groups.has(key)) {
      groups.set(key, { cwd: item.cwd, processes: new Map() });
    }
    const group = groups.get(key);
    const procKey = `${item.command}::${item.pid}`;
    if (!group.processes.has(procKey)) {
      group.processes.set(procKey, { command: item.command, pid: item.pid, cmdline: item.cmdline, ports: [] });
    }
    group.processes.get(procKey).ports.push(item.port);
  }

  // Drop cards for processes that stopped listening since the last poll.
  for (const [key, entry] of extraCardsByKey) {
    if (!groups.has(key)) {
      entry.card.remove();
      extraCardsByKey.delete(key);
    }
  }

  // Top banner: the whole point is to make "did I forget to register a
  // project?" impossible to miss without scrolling past a wall of Unity /
  // Adobe / system-helper noise.
  if (groups.size > 0) {
    banner.style.display = 'flex';
    bannerText.textContent = `⚠️ projects.yml に未登録のプロセスが ${groups.size} 件 (${visible.length}ポート) 動作中です`;
  } else {
    banner.style.display = 'none';
  }

  if (hiddenCount > 0) {
    ignoredLink.style.display = '';
    ignoredLink.textContent = `無視中のプロセス ${hiddenCount}件 (リセット)`;
  } else {
    ignoredLink.style.display = 'none';
  }

  for (const [key, group] of groups) {
    let entry = extraCardsByKey.get(key);
    if (!entry) {
      // Registered projects (already in the grid from page load) come
      // first; unregistered ones are appended after them, last -- the
      // banner above already makes them impossible to miss, so the day-to-
      // day card order can prioritize the user's own known projects.
      entry = buildExtraCard(key);
      extraCardsByKey.set(key, entry);
      grid.appendChild(entry.card);
    }
    // Process list + ports are refreshed on an existing card -- leaves any
    // open registration form (and whatever the user typed into it) alone.
    refreshExtraCard(entry, group);
  }
}

// Inline "register into projects.yml" form for one unregistered-process
// card. Reads from entry.group (always current) rather than a value
// captured at button-creation time, and merges every port across every
// process sharing this cwd into one project entry.
function buildRegisterForm(entry, formSlot) {
  const group = entry.group;
  const processes = Array.from(group.processes.values());
  const suggestedName = (group.cwd ? dirBaseName(group.cwd) : processes[0].command)
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '') || 'project';
  const allPorts = Array.from(new Set(processes.flatMap((p) => p.ports))).sort((a, b) => a - b);

  const nameInput = el('input', { type: 'text', value: suggestedName, placeholder: 'project-name (小文字/数字/-/_)' });
  const pathInput = el('input', { type: 'text', value: group.cwd ? shortenPath(group.cwd) : '', placeholder: 'path' });
  const descInput = el('input', { type: 'text', placeholder: '説明 (任意)' });
  const techInput = el('input', { type: 'text', placeholder: 'tech (カンマ区切り, 任意)' });
  const errorEl = el('div', { class: 'error' });
  const submitBtn = el('button', { class: 'dismiss-card primary', text: '登録する' });
  const cancelBtn = el('button', { class: 'dismiss-card', text: 'キャンセル' });

  submitBtn.addEventListener('click', async () => {
    submitBtn.disabled = true;
    errorEl.textContent = '';
    try {
      const res = await fetch('/api/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: nameInput.value,
          path: pathInput.value,
          description: descInput.value,
          tech: techInput.value,
          ports: allPorts,
        }),
      });
      const data = await res.json();
      if (!data.ok) throw new Error(data.error || 'failed');
      location.reload();
    } catch (e) {
      errorEl.textContent = '登録失敗: ' + e.message;
      submitBtn.disabled = false;
    }
  });
  cancelBtn.addEventListener('click', () => {
    formSlot.innerHTML = '';
  });

  return el('div', { class: 'register-form' }, [
    nameInput,
    pathInput,
    descInput,
    techInput,
    errorEl,
    el('div', { class: 'card-actions' }, [submitBtn, cancelBtn]),
  ]);
}

// Liveness is decided server-side (same lsof-based check as `check-ports`),
// fetched fresh on every poll from a same-origin endpoint. This avoids the
// false results a cross-origin browser fetch() gives for non-HTTP ports.
async function checkAll() {
  const dots = Array.from(document.querySelectorAll('.dot[data-port]'));
  try {
    const res = await fetch('/api/status', { cache: 'no-store' });
    if (!res.ok) throw new Error('bad response');
    const listening = await res.json();
    const listeningPorts = new Set(listening.map((item) => item.port));

    document.getElementById('offline-banner').style.display = 'none';
    dots.forEach((d) => {
      const port = Number(d.getAttribute('data-port'));
      d.classList.remove('checking');
      d.classList.toggle('up', listeningPorts.has(port));
      d.classList.toggle('down', !listeningPorts.has(port));
    });
    const up = dots.filter((d) => d.classList.contains('up')).length;
    document.getElementById('summary').innerHTML =
      `<b>${up}</b> / ${dots.length} ports running (実測: lsof) &middot; last checked ${new Date().toLocaleTimeString('ja-JP')}`;

    updateAlwaysOn(listeningPorts);
    renderExtra(listening);
  } catch (e) {
    document.getElementById('offline-banner').style.display = 'block';
    document.getElementById('summary').textContent = 'ライブチェック利用不可（サーバーモードで開いてください）';
  }
}

document.getElementById('refresh-btn').addEventListener('click', checkAll);
checkAll();
setInterval(checkAll, 5000);
</script>
</body>
</html>
"""


def render_html(entries, dash_port):
    payload = json.dumps(entries, ensure_ascii=False).replace("</script>", "<\\/script>")
    generated_at = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    return (
        HTML_TEMPLATE.replace("__PROJECTS_JSON__", payload)
        .replace("__GENERATED_AT__", generated_at)
        .replace("__DASH_PORT__", str(dash_port))
        .replace("__HOME_DIR__", json.dumps(HOME_DIR))
    )


def generate(dash_port=DEFAULT_PORT):
    projects = load_projects()
    entries = build_entries(projects)
    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
    OUTPUT_FILE.write_text(render_html(entries, dash_port), encoding="utf-8")
    return entries


def make_handler():
    class Handler(SimpleHTTPRequestHandler):
        def __init__(self, *args, **kwargs):
            super().__init__(*args, directory=str(OUTPUT_DIR), **kwargs)

        def do_GET(self):
            if self.path == "/api/status":
                listening = sorted(scan_listening().values(), key=lambda item: item["port"])
                self._json_response(200, listening)
                return
            super().do_GET()

        def do_POST(self):
            length = int(self.headers.get("Content-Length", 0) or 0)
            raw = self.rfile.read(length) if length else b"{}"
            try:
                payload = json.loads(raw or b"{}")
            except json.JSONDecodeError:
                payload = {}

            if self.path == "/api/kill":
                self._handle_kill(payload)
            elif self.path == "/api/register":
                self._handle_register(payload)
            elif self.path == "/api/add-port":
                self._handle_add_port(payload)
            elif self.path == "/api/start":
                self._handle_start(payload)
            elif self.path == "/api/set-config":
                self._handle_set_config(payload)
            else:
                self._json_response(404, {"ok": False, "error": "not found"})

        def _json_response(self, status, obj):
            body = json.dumps(obj).encode()
            self.send_response(status)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def _handle_kill(self, payload):
            try:
                pid = int(payload.get("pid"))
            except (TypeError, ValueError):
                return self._json_response(400, {"ok": False, "error": "invalid pid"})

            # Only allow killing a pid that is *right now* one of the ports
            # we ourselves reported as listening -- prevents a stale/spoofed
            # pid in the request body from touching an unrelated process.
            live_pids = {int(item["pid"]) for item in scan_listening().values()}
            if pid not in live_pids:
                return self._json_response(400, {"ok": False, "error": "pid is not a currently-listening process"})

            try:
                subprocess.run(["kill", "-TERM", str(pid)], timeout=3, check=True)
            except Exception as e:
                return self._json_response(500, {"ok": False, "error": str(e)})
            self._json_response(200, {"ok": True})

        def _handle_register(self, payload):
            ok, error = register_project(payload)
            if not ok:
                return self._json_response(400, {"ok": False, "error": error})
            generate(dash_port=self.server.server_address[1])
            self._json_response(200, {"ok": True})

        def _handle_add_port(self, payload):
            name = str(payload.get("name", "")).strip()
            try:
                ports = sorted({int(p) for p in (payload.get("ports") or [])})
            except (TypeError, ValueError):
                return self._json_response(400, {"ok": False, "error": "invalid ports"})
            if not name or not ports:
                return self._json_response(400, {"ok": False, "error": "name and ports are required"})

            ok, error = add_ports_to_project(name, ports)
            if not ok:
                return self._json_response(400, {"ok": False, "error": error})
            generate(dash_port=self.server.server_address[1])
            self._json_response(200, {"ok": True})

        def _handle_start(self, payload):
            name = str(payload.get("name", "")).strip()
            if not name:
                return self._json_response(400, {"ok": False, "error": "name is required"})
            ok, error = start_project(name)
            if not ok:
                return self._json_response(400, {"ok": False, "error": error})
            self._json_response(200, {"ok": True})

        def _handle_set_config(self, payload):
            name = str(payload.get("name", "")).strip()
            if not name:
                return self._json_response(400, {"ok": False, "error": "name is required"})
            always_on = bool(payload.get("always_on", False))
            # `start_command` absent -> leave untouched; present (even "") ->
            # set/remove. The ⚙ form always sends it, so it's authoritative.
            start_command = payload.get("start_command", None)
            ok, error = set_project_config(name, always_on, start_command)
            if not ok:
                return self._json_response(400, {"ok": False, "error": error})
            generate(dash_port=self.server.server_address[1])
            self._json_response(200, {"ok": True})

        def log_message(self, fmt, *args):
            pass  # keep stdout quiet

    return Handler


def serve(port):
    entries = generate(dash_port=port)
    print(f"✅ Dashboard generated: {OUTPUT_FILE} ({len(entries)} projects)")
    TCPServer.allow_reuse_address = True
    with TCPServer(("127.0.0.1", port), make_handler()) as httpd:
        print(f"🌐 Serving on http://localhost:{port}/  (Ctrl-C to stop)")
        try:
            httpd.serve_forever()
        except KeyboardInterrupt:
            pass


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--serve", action="store_true", help="serve with live status endpoint")
    parser.add_argument("--port", type=int, default=DEFAULT_PORT)
    args = parser.parse_args()

    if args.serve:
        serve(args.port)
    else:
        entries = generate()
        print(f"✅ Dashboard generated: {OUTPUT_FILE} ({len(entries)} projects)")


if __name__ == "__main__":
    main()
